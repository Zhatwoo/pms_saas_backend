NODE_ENV=production
PORT=4000
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.example:password@aws-0-region.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=public-anon-key-used-server-side-for-auth-password-verification
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_JWT_SECRET=jwt-secret-from-supabase-auth-settings

JWT_EXPIRES_IN=1d
PASSWORD_CHANGE_SECRET=replace-with-32-byte-secret
ALLOW_BEARER_AUTH=false
