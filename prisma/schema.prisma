generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model branches {
  id                                                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_code                                            String                     @unique @default(dbgenerated("lpad((nextval('branch_code_seq'::regclass))::text, 3, '0'::text)"))
  name                                                   String                     @unique
  location                                               String
  status                                                 String                     @default("Active")
  created_at                                             DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime                   @default(now()) @db.Timestamptz(6)
  contact_number                                         String?
  /// Configured opening cash when no prior daily_balances row exists (initial capital).
  opening_cash_balance                                   Decimal                    @default(0) @db.Decimal(12, 2)
  /// LOAN_AMOUNT: sum pawn loan amounts; APPRAISED_VALUE: sum appraised_value with fallback to amount.
  inventory_valuation_mode                               String                     @default("LOAN_AMOUNT")
  activity_logs                                          activity_logs[]
  branch_business_sessions                               branch_business_sessions[]
  branch_day_sessions                                    branch_day_sessions[]
  customer_rewards                                       customer_rewards[]
  customers                                              customers[]
  daily_balances                                         daily_balances[]
  daily_opening                                          daily_opening[]
  finance_audit_events                                   finance_audit_events[]
  fund_requests_fund_requests_branch_idTobranches        fund_requests[]            @relation("fund_requests_branch_idTobranches")
  fund_requests_fund_requests_source_branch_idTobranches fund_requests[]            @relation("fund_requests_source_branch_idTobranches")
  incident_ticket_events                                 incident_ticket_events[]
  incident_tickets                                       incident_tickets[]
  layaway_reservations                                   layaway_reservations[]
  notifications                                          notifications[]
  pawned_items                                           pawned_items[]
  sale_items                                             sale_items[]
  transactions                                           transactions[]
  users                                                  users[]

  @@schema("public")
}

model users {
  id                                                                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_id                                                              String                     @unique @db.Uuid
  full_name                                                            String                     @default("")
  email                                                                String                     @unique
  role                                                                 String                     @default("employee")
  branch_id                                                            String?                    @db.Uuid
  created_at                                                           DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                                           DateTime                   @default(now()) @db.Timestamptz(6)
  avatar_url                                                           String?
  account_status                                                       String                     @default("active")
  activity_logs                                                        activity_logs[]
  branch_sessions_ended                                                branch_business_sessions[] @relation("branch_sessions_ended_by")
  branch_sessions_started                                              branch_business_sessions[] @relation("branch_sessions_started_by")
  branch_day_sessions_closed                                           branch_day_sessions[]      @relation("branch_day_sessions_closed_by")
  branch_day_sessions_started                                          branch_day_sessions[]      @relation("branch_day_sessions_started_by")
  customer_rewards                                                     customer_rewards[]
  daily_opening                                                        daily_opening[]            @relation("DailyOpeningEmployeeActor")
  daily_opening_last_updates                                           daily_opening[]            @relation("DailyOpeningLastUpdatedBy")
  finance_audit_events                                                 finance_audit_events[]
  fund_requests_fund_requests_confirmed_by_user_idTousers              fund_requests[]            @relation("fund_requests_confirmed_by_user_idTousers")
  fund_requests_fund_requests_destination_confirmed_by_user_idTousers  fund_requests[]            @relation("fund_requests_destination_confirmed_by_user_idTousers")
  fund_requests_fund_requests_receiver_user_idTousers                  fund_requests[]            @relation("fund_requests_receiver_user_idTousers")
  fund_requests_fund_requests_requested_by_user_idTousers              fund_requests[]            @relation("fund_requests_requested_by_user_idTousers")
  fund_requests_fund_requests_reviewed_by_user_idTousers               fund_requests[]            @relation("fund_requests_reviewed_by_user_idTousers")
  fund_requests_fund_requests_source_confirmed_by_user_idTousers       fund_requests[]            @relation("fund_requests_source_confirmed_by_user_idTousers")
  fund_requests_fund_requests_transferred_by_user_idTousers            fund_requests[]            @relation("fund_requests_transferred_by_user_idTousers")
  incident_ticket_events_incident_ticket_events_actor_user_idTousers   incident_ticket_events[]   @relation("incident_ticket_events_actor_user_idTousers")
  incident_ticket_events_incident_ticket_events_subject_user_idTousers incident_ticket_events[]   @relation("incident_ticket_events_subject_user_idTousers")
  incident_tickets_incident_tickets_escalation_owner_user_idTousers    incident_tickets[]         @relation("incident_tickets_escalation_owner_user_idTousers")
  incident_tickets_incident_tickets_reported_by_user_idTousers         incident_tickets[]         @relation("incident_tickets_reported_by_user_idTousers")
  incident_tickets_incident_tickets_resolved_byTousers                 incident_tickets[]         @relation("incident_tickets_resolved_byTousers")
  incident_tickets_incident_tickets_user_idTousers                     incident_tickets[]         @relation("incident_tickets_user_idTousers")
  layaway_reservations                                                 layaway_reservations[]
  notifications                                                        notifications[]
  transactions                                                         transactions[]
  transactions_voided                                                  transactions[]             @relation("transactions_voided_by_user_idTousers")
  users                                                                auth_users                 @relation(fields: [auth_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branches                                                             branches?                  @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([auth_id])
  @@schema("public")
}

model customers {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name            String
  address              String
  barangay             String?
  city                 String?
  region               String?
  contact_number       String?
  email                String?
  id_presented         String?
  branch_id            String                 @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  customer_rewards     customer_rewards[]
  branches             branches               @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  layaway_reservations layaway_reservations[]
  notifications        notifications[]
  pawned_items         pawned_items[]
  sale_items           sale_items[]
  transactions         transactions[]

  @@index([branch_id, deleted_at, created_at(sort: Desc)], map: "idx_customers_branch_deleted_created")
  @@schema("public")
}

model pawned_items {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id                String          @unique
  item_name              String
  category               String
  branch_id              String          @db.Uuid
  branch                 String
  pawn_date              DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  status                 String          @default("Active")
  remarks                String          @default("")
  qr_code                String?         @unique
  condition_report       String?
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime        @default(now()) @db.Timestamptz(6)
  customer_id            String?         @db.Uuid
  profile_photo          String?
  id_photo               String?
  amount                 Decimal?        @default(0) @db.Decimal(15, 2)
  serial_number          String?
  items_included         String?
  condition              String?
  memory_storage         String?
  id_back_photo          String?
  item_photos            Json            @default("[]")
  item_photo             String?
  appraised_value        Decimal?        @db.Decimal(15, 2)
  estimated_resale_value Decimal?        @db.Decimal(15, 2)
  item_renewals          item_renewals[]
  branches               branches        @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  customers              customers?      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale_items             sale_items?
  transactions           transactions[]

  @@index([branch_id, status], map: "idx_pawned_items_branch_status")
  @@index([item_name(ops: raw("gin_trgm_ops"))], map: "idx_pawned_items_item_name_trgm", type: Gin)
  @@index([pawn_date(sort: Desc)], map: "idx_pawned_items_pawn_date")
  @@schema("public")
}

model transactions {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_no         String                 @unique
  branch_id              String?                @db.Uuid
  branch                 String
  purpose                String
  transaction_date       DateTime               @default(dbgenerated("CURRENT_DATE")) @db.Date
  transaction_time       DateTime               @default(dbgenerated("LOCALTIME(0)")) @db.Time(6)
  cash_in                Decimal                @default(0) @db.Decimal(12, 2)
  cash_out               Decimal                @default(0) @db.Decimal(12, 2)
  return_amount          Decimal                @default(0) @db.Decimal(12, 2)
  unit                   String?
  unit_code              String?
  pawn_amount            Decimal                @default(0) @db.Decimal(12, 2)
  storage_fee            Decimal                @default(0) @db.Decimal(12, 2)
  details                String?
  related_pawned_item_id String?                @db.Uuid
  related_sale_item_id   String?                @db.Uuid
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  profile_photo          String?
  id_photo               String?
  created_by_user_id     String?                @db.Uuid
  id_back_photo          String?
  customer_id            String?                @db.Uuid
  voided_at              DateTime?              @db.Timestamptz(6)
  voided_by_user_id      String?                @db.Uuid
  finance_audit_events   finance_audit_events[]
  fund_requests          fund_requests[]
  layaway_reservations   layaway_reservations[]
  branches               branches?              @relation(fields: [branch_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users                  users?                 @relation(fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  customers              customers?             @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pawned_items           pawned_items?          @relation(fields: [related_pawned_item_id], references: [id], onUpdate: NoAction)
  sale_items             sale_items?            @relation(fields: [related_sale_item_id], references: [id], onUpdate: NoAction)
  voided_by_user         users?                 @relation("transactions_voided_by_user_idTousers", fields: [voided_by_user_id], references: [id], onUpdate: NoAction)

  @@index([branch_id, created_at(sort: Desc)], map: "idx_transactions_branch_created_at")
  @@index([branch_id, transaction_date(sort: Desc)], map: "idx_transactions_branch_transaction_date")
  @@index([customer_id], map: "idx_transactions_customer_id")
  @@index([purpose], map: "idx_transactions_purpose")
  @@schema("public")
}

/// Append-only finance audit trail (balance edits, recalculations, corrections).
model finance_audit_events {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id      String?       @db.Uuid
  user_id        String?       @db.Uuid
  event_type     String
  payload        Json          @default("{}")
  ip_address     String?
  user_agent     String?
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  transaction_id String?       @db.Uuid
  branches       branches?     @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  transactions   transactions? @relation(fields: [transaction_id], references: [id], onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([branch_id, created_at(sort: Desc)], map: "idx_finance_audit_branch_created")
  @@index([event_type], map: "idx_finance_audit_event_type")
  @@schema("public")
}

model daily_balances {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id        String   @db.Uuid
  record_date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  starting_balance Decimal  @default(0) @db.Decimal(12, 2)
  ending_balance   Decimal  @default(0) @db.Decimal(12, 2)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  branches         branches @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([branch_id, record_date])
  @@index([branch_id, record_date(sort: Desc)], map: "idx_daily_balances_branch_date")
  @@schema("public")
}

/// Branch-wide finance day lifecycle (Manila calendar): OPEN / CLOSED / AUTO_CLOSED / PENDING_START_BALANCE.
model branch_business_sessions {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id                    String    @db.Uuid
  business_date                DateTime  @db.Date
  status                       String    @default("PENDING_START_BALANCE")
  starting_balance             Decimal?  @db.Decimal(12, 2)
  ending_balance               Decimal?  @db.Decimal(12, 2)
  started_at                   DateTime? @db.Timestamptz(6)
  ended_at                     DateTime? @db.Timestamptz(6)
  started_by_user_id           String?   @db.Uuid
  ended_by_user_id             String?   @db.Uuid
  auto_closed                  Boolean   @default(false)
  locked                       Boolean   @default(false)
  inventory_valuation_snapshot Json      @default("{}")
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @default(now()) @db.Timestamptz(6)
  branches                     branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ended_by_user                users?    @relation("branch_sessions_ended_by", fields: [ended_by_user_id], references: [id], onUpdate: NoAction)
  started_by_user              users?    @relation("branch_sessions_started_by", fields: [started_by_user_id], references: [id], onUpdate: NoAction)

  @@unique([branch_id, business_date], map: "branch_business_sessions_branch_date_key")
  @@index([branch_id, business_date(sort: Desc)], map: "idx_branch_business_sessions_branch_date")
  @@schema("public")
}

/// Per-branch Manila calendar day: opening starting balance + end-day closure gate for operational cash.
model branch_day_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id          String    @db.Uuid
  /// Manila calendar date (YYYY-MM-DD) stored as date-only.
  session_date       DateTime  @db.Date
  starting_balance   Decimal   @db.Decimal(12, 2)
  is_closed          Boolean   @default(false)
  closed_at               DateTime? @db.Timestamptz(6)
  opened_at               DateTime  @default(now()) @db.Timestamptz(6)
  /// Cash in/out before this instant belongs to a prior shift (same Manila date). Set on each Start Day.
  operational_cutoff_at   DateTime? @db.Timestamptz(6)
  /// Operational transaction ids already booked before this shift (excluded from net). Set on each Start Day.
  sealed_transaction_ids  String[]  @default([]) @db.Uuid
  started_by_user_id      String?   @db.Uuid
  closed_by_user_id  String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  branches           branches  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  closed_by_user     users?    @relation("branch_day_sessions_closed_by", fields: [closed_by_user_id], references: [id], onUpdate: NoAction)
  started_by_user    users?    @relation("branch_day_sessions_started_by", fields: [started_by_user_id], references: [id], onUpdate: NoAction)

  @@unique([branch_id, session_date], map: "branch_day_sessions_branch_session_date_key")
  @@index([branch_id, session_date(sort: Desc)], map: "idx_branch_day_sessions_branch_date")
  @@schema("public")
}

model activity_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  branch_id  String?   @db.Uuid
  action     String
  details    String?
  created_at DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  branches   branches? @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_activity_logs_created_at")
  @@schema("public")
}

model notifications {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?    @db.Uuid
  branch_id   String?    @db.Uuid
  title       String
  subtitle    String?
  category    String?
  is_read     Boolean?   @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  customer_id String?    @db.Uuid
  log_id      String?    @db.Uuid
  branches    branches?  @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers   customers? @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([branch_id], map: "idx_notifications_branch_id")
  @@index([customer_id], map: "idx_notifications_customer_id")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([log_id], map: "idx_notifications_log_id")
  @@schema("public")
}

